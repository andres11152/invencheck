{
  "name": "invencheck-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo para la PWA de Gestión de Inventarios y Toma Física por Voz de Colsubsidio",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run start:dev -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "build:shared": "npm run build -w shared"
  }
}
