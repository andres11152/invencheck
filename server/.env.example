# Requerido. Conexión del PROCESO de la app. Usa el rol SIN privilegios
# `invencheck_app` (lo crea la migración _rol_aplicacion_sin_privilegios):
# es el único rol alcanzado por las policies de Row Level Security que aíslan
# las organizaciones entre sí. Un superusuario se las salta SIEMPRE, así que
# la app se niega a arrancar si detecta uno — ver PrismaService.
DATABASE_URL="postgresql://invencheck_app:invencheck_app@localhost:5432/invencheck?schema=public"

# Opcional (default: DATABASE_URL). Conexión de la CLI de Prisma —
# migrate / seed / studio / import-excel — con el rol DUEÑO de las tablas,
# que necesita DDL y se salta RLS a propósito. El proceso de NestJS nunca la
# usa; solo la lee prisma.config.ts.
DATABASE_URL_MIGRATIONS="postgresql://invencheck:invencheck@localhost:5432/invencheck?schema=public"

# Opcional: si no se define, AiEngineService usa el parser local en español
# (sin llamadas externas) para procesar dictado de voz.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Requerido. Genera uno propio: `openssl rand -hex 32`. Nunca reutilices el
# valor de ejemplo de este archivo en un ambiente real.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=43200

# Requerido para que los webhooks de integración (sync-articulo/sync-almacen)
# acepten peticiones del ERP externo. Genera uno propio y compártelo solo con
# el sistema ERP que va a llamar a estos endpoints.
ERP_WEBHOOK_API_KEY=

# Opcional. Lista de origins permitidos por CORS separados por coma
# (ej. "http://localhost:3001,https://invencheck.colsubsidio.com").
# Default: http://localhost:3001.
CORS_ORIGIN=

# Opcional. URL del ERP externo que recibe el inventario consolidado
# (POST) al transicionar a ENVIADO_ERP. Default: el mock local de demo
# (/integration/mock-erp/receive-inventario).
ERP_INTEGRATION_URL=
